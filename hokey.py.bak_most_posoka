def nazad(prozorec="20260401-20260416", kolko=5):
    """Назадният ход: истински МИНАЛИ мачове, цена -> карта -> резултат.

    Причината този режим да съществува: спорт, който отваря след 35 дни, не
    може да се изпита напред. Но ако пътят работи НАЗАД върху завършили
    мачове, ще работи и напред — това е единственият начин да се разбере дали
    нулата от 11.08 е сезон или дефект.

    🔴 ЧЕТЕ ЦЕНАТА ОТ ESPN, НЕ ОТ PINNACLE. Guest слоят на Pinnacle показва
    само витрината СЕГА; минали цени няма откъде да дойдат оттам. ESPN core
    пази open/current/close за НХЛ — измерено днес: 125 от 125 мача.
    """
    pred = _modul("predictor")
    pz = _modul("pazar")
    if pred is None or not hasattr(pred, "model_hockey"):
        print("🔴 нямам predictor.model_hockey")
        return 1
    site = ("https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/"
            "scoreboard?dates=%s&limit=900" % prozorec)
    core = "https://sports.core.api.espn.com/v2/sports/hockey/leagues/nhl"
    j = _vzemi(site)
    if j is None:
        print("🔴 ESPN не отговори")
        return 1
    # ESPN пише LA/NJ/SJ/TB, НХЛ пише LAK/NJD/SJS/TBL. Четири от 32.
    MOST = {"LA": "LAK", "NJ": "NJD", "SJ": "SJS", "TB": "TBL"}
    redove = []
    for ev in (j.get("events") or []):
        c = (ev.get("competitions") or [{}])[0]
        if (((c.get("status") or {}).get("type") or {}).get("name")
                != "STATUS_FINAL"):
            continue
        h = a = None
        for k in (c.get("competitors") or []):
            if k.get("homeAway") == "home":
                h = k
            elif k.get("homeAway") == "away":
                a = k
        if not h or not a:
            continue
        ab_h = (h.get("team") or {}).get("abbreviation") or ""
        ab_a = (a.get("team") or {}).get("abbreviation") or ""
        redove.append({
            "id": ev.get("id"), "den": str(ev.get("date") or "")[:10],
            "hn": (h.get("team") or {}).get("displayName"),
            "an": (a.get("team") or {}).get("displayName"),
            "hid": MOST.get(ab_h, ab_h), "aid": MOST.get(ab_a, ab_a),
            "hs": int(h.get("score") or 0), "as": int(a.get("score") or 0),
            "hw": bool(h.get("winner"))})
    print("🏒 НАЗАДНИЯТ ХОД · прозорец %s" % prozorec)
    print("   завършени мача: %d" % len(redove))
    s_cena = s_model = s_pat = 0
    pokazani = 0
    for r in redove:
        o = _vzemi("%s/events/%s/competitions/%s/odds" % (core, r["id"], r["id"]))
        it = ((o or {}).get("items") or [None])[0]
        cd = cg = None
        if it:
            for kade, e in (("homeTeamOdds", "d"), ("awayTeamOdds", "g")):
                dyal = (it.get(kade) or {})
                sn = dyal.get("close") or dyal.get("current") or {}
                ml = sn.get("moneyLine")
                v = ml.get("decimal") if isinstance(ml, dict) else None
                if e == "d":
                    cd = v
                else:
                    cg = v
        m = pred.model_hockey({"home_id": r["hid"], "away_id": r["aid"],
                               "bucket": NASH_KLYUCH})
        if cd and cg:
            s_cena += 1
        if m:
            s_model += 1
        if not (cd and cg and m):
            continue
        s_pat += 1
        if pokazani >= int(kolko):
            continue
        pokazani += 1
        pp = pz.bez_marzh(NASH_KLYUCH, cd, cg)[0] if pz else None
        ph = m["p_home"]
        izbor = ("1 · %s" % r["hn"]) if ph >= 0.5 else ("2 · %s" % r["an"])
        p = ph if ph >= 0.5 else 1.0 - ph
        verno = (ph >= 0.5) == r["hw"]
        print()
        print("   %s  %s vs %s" % (r["den"], r["hn"], r["an"]))
        print("      ЦЕНА     %.2f / %.2f   пазарът дава на домакина %s"
              % (cd, cg, ("%.1f%%" % (pp * 100.0)) if pp else "—"))
        print("      КАРТА    %s   %.0f%%   (цял мач, с продълженията)"
              % (izbor, p * 100.0))
        print("      РЕЗУЛТАТ %d : %d   ->   %s"
              % (r["hs"], r["as"], "ПОЗНАТА ✅" if verno else "СГРЕШЕНА ❌"))
    n = len(redove)
    print()
    print("   с цена  %d/%d · с модел %d/%d · ЦЕЛИЯТ ПЪТ %d/%d"
          % (s_cena, n, s_model, n, s_pat, n))
    print("   🔴 без ръб-число: моделът чете standings/now, а тя е таблицата")
    print("      на КРАЯ на сезона — всяка сметка за познати е с надничане.")
    return 0


