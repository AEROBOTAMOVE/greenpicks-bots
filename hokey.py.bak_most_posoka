def _rez_nhl(j):
    """Суровият отговор на api-web /score/<дата> -> [(дом, гост, гдом, ггост)]."""
    out = []
    for g in ((j or {}).get("games") or []):
        if not isinstance(g, dict):
            continue
        if str(g.get("gameState") or "").upper() not in ("OFF", "FINAL"):
            continue
        h, a = g.get("homeTeam") or {}, g.get("awayTeam") or {}
        hn = (h.get("name") or {}).get("default") or h.get("abbrev") or ""
        an = (a.get("name") or {}).get("default") or a.get("abbrev") or ""
        try:
            hs, as_ = int(h.get("score")), int(a.get("score"))
        except (TypeError, ValueError):
            continue
        if not hn or not an:
            continue
        out.append((str(hn), str(an), hs, as_))
    return out


def _rez_espn(j):
    """Суровият отговор на ESPN scoreboard -> [(дом, гост, гдом, ггост)]."""
    out = []
    for ev in ((j or {}).get("events") or []):
        if not isinstance(ev, dict):
            continue
        for c in (ev.get("competitions") or []):
            st = ((c.get("status") or {}).get("type") or {}).get("name")
            if str(st) != "STATUS_FINAL":
                continue
            h = a = None
            for k in (c.get("competitors") or []):
                if k.get("homeAway") == "home":
                    h = k
                elif k.get("homeAway") == "away":
                    a = k
            if not h or not a:
                continue
            try:
                hs, as_ = int(h.get("score")), int(a.get("score"))
            except (TypeError, ValueError):
                continue
            hn = ((h.get("team") or {}).get("displayName")
                  or (h.get("team") or {}).get("abbreviation") or "")
            an = ((a.get("team") or {}).get("displayName")
                  or (a.get("team") or {}).get("abbreviation") or "")
            if not hn or not an:
                continue
            out.append((str(hn), str(an), hs, as_))
    return out


def rezultati(sadiya_kod, ymd, vzemi=None):
    """[(дом, гост, гол_дом, гол_гост)] за един ден. NEPITAN при отказ.

    🔴 ПРАЗЕН СПИСЪК И ОТКАЗ НЕ СА ЕДНО И СЪЩО и точно тук разликата е скъпа:
    празният ден изглежда като „мачът не се е състоял" и картата се затваря
    БЕЗ присъда. Затова отказът е СЕНТИНЕЛ, не [].

    `vzemi` се подава от самопроверката — тя не пипа мрежата.
    """
    adres = SADII.get(str(sadiya_kod))
    if not adres:
        return NEPITAN
    d = str(ymd or "").strip()
    if not d:
        return NEPITAN
    if str(sadiya_kod) == "nhl":
        url = adres % d                             # api-web иска 2026-04-08
        raz = _rez_nhl
    else:
        url = adres % d.replace("-", "")            # ESPN иска 20260408
        raz = _rez_espn
    j = (vzemi or _vzemi)(url)
    if j is None:
        return NEPITAN
    return raz(j)


def otsadi(dom, gost, redove):
    """„1" / „2" / „X" / None — кой е спечелил ЦЕЛИЯ мач (с продълженията).

    „X" НЕ Е ИЗХОД ТУК и се връща само ако изворът наистина даде равен резултат
    след продълженията. При НХЛ това е невъзможно от 2005 г. — но „невъзможно"
    е дума, която вече ни е лъгала, а мълчаливото превръщане на равен в загуба
    е измислен резултат. По-добре присъда, която стърчи, отколкото удобна лъжа.
    """
    if redove is NEPITAN:
        return None
    nd, ng = _norm(dom), _norm(gost)
    if not nd or not ng or nd == ng:
        return None
    dalag = len(nd) >= 4 and len(ng) >= 4
    nameren = None
    for hn, an, hs, as_ in (redove or []):
        h, a = _norm(hn), _norm(an)
        if {h, a} == {nd, ng}:
            obarnat = (h == ng)
        elif dalag and h.endswith(nd) and a.endswith(ng):
            obarnat = False
        elif dalag and h.endswith(ng) and a.endswith(nd):
            obarnat = True
        else:
            continue
        if nameren is not None:
            return None                  # двама кандидати — мълчание
        md, mg = (as_, hs) if obarnat else (hs, as_)
        nameren = "1" if md > mg else ("2" if mg > md else "X")
    return nameren


def sezon_kapan(pred=None):
    """(наред_ли, обяснение) — капанът, който ще щракне на 29.09.

    `nhl_table` изхвърля отбор с под 5 мача. Тръгне ли `standings/now` към
    ПРАЗНИЯ нов сезон точно на старта, таблицата става {} и ВСЯКА карта умира
    мълчаливо — спортът се отваря и пак дава нула, точно както на 11.08, но
    този път по СЪВСЕМ ДРУГА причина. Затова се пита на глас.

    Измерено 25.08.2026: `standings/now` връща seasonId 20252026, 32 отбора,
    всичките с 82 мача. Тоест днес капанът е спуснат, но не е щракнал.
    """
    pred = pred if pred is not None else _modul("predictor")
    if pred is None or not hasattr(pred, "nhl_table"):
        return (None, "нямам predictor — не мога да питам")
    try:
        tab = pred.nhl_table()
    except Exception as e:                                   # noqa: BLE001
        return (False, "таблицата гръмна: %s" % e)
    if not isinstance(tab, dict):
        return (False, "таблицата не е речник")
    if len(tab) < 20:
        return (False, "таблицата е с %d отбора — под 20; всяка карта ще "
                       "умре без число" % len(tab))
    return (True, "таблицата носи %d отбора" % len(tab))


