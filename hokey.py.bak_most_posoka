# ═════════════════════════════════════════ ГЛАВИТЕ: ТРИ ДОМАКИНА, ТРИ ПРАВИЛА
def glavi_za(url):
    """Заглавките за този домакин. Измерено на живо 25.08.2026, три хоста:

                              БЕЗ глава „User-Agent"      с ПРАЗЕН „User-Agent"
        api-web.nhle.com              403                          200
        site.api.espn.com             200                          403
        guest.api.arcadia.pinnacle    200                          200

    Тоест двата извора искат ТОЧНО ОБРАТНОТО и една обща настройка не може да
    ги обслужи. Това НЕ е заобикаляне на защита: нищо не се преправя на
    браузър. При ESPN просто не пипаме главата и си оставаме „Python-urllib";
    при НХЛ подаваме ПРАЗЕН низ, тоест казваме по-малко, не повече.

    🔴 ПАМЕТТА МИ КАЗВАШЕ „ESPN отговаря на ПРАЗЕН User-Agent". ГРЕШНО, и днес
    си струваше 403. Вярното е „ESPN отговаря, когато главата я НЯМА".
    Разликата между „празна глава" и „никаква глава" е един HTTP код.
    """
    u = str(url or "")
    if "nhle.com" in u:
        return {"User-Agent": "", "Accept": "application/json"}
    return {"Accept": "application/json"}


def _vzemi(url):
    """JSON от адрес, или None. Единственото място с мрежа в този файл."""
    try:
        rq = urllib.request.Request(str(url), headers=glavi_za(url))
        with urllib.request.urlopen(rq, timeout=TIMEOUT) as r:
            return json.loads(r.read())
    except Exception:                                        # noqa: BLE001
        return None


def _modul(ime):
    """Модул по име или None.

    През `__import__`, за да може самопроверката да подмени записа в
    sys.modules и нито една проверка да не пипне мрежата.
    """
    try:
        return __import__(str(ime))
    except Exception:                                        # noqa: BLE001
        return None


# ═════════════════════════════════════════════════════════ ИМЕНАТА
def _bez_akcenti(s):
    """„Montréal" -> „Montreal". Разлага буквата и хвърля знака отгоре.

    🔴 БЕЗ ТОВА ЕДИН ОТ 32-та ОТБОРА Е НЕВИДИМ (измерено 25.08.2026).
    `str.isalnum()` е ИСТИНА за „é", тоест голото свеждане пази акцента и
    „montréalcanadiens" никога не среща „montrealcanadiens". Мълчаливо, с вид
    на „този мач просто го няма". Същият капан като кирилицата при волейбола
    и при тениса.
    """
    t = unicodedata.normalize("NFKD", str(s or ""))
    return "".join(ch for ch in t if not unicodedata.combining(ch))


def _norm(s):
    """Име, сведено до сравнимо: без акценти, малки букви, само букви и цифри."""
    return "".join(ch for ch in _bez_akcenti(s).lower() if ch.isalnum())


