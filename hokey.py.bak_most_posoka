    Единственият вход към белия списък. Всяко друго място пита ТУК, за да
    няма два преписа на един и същ въпрос.
    """
    return SADI.get(_norm(liga), (None, None))


def sadima(liga):
    """Може ли изобщо да се отсъди мач от тази лига."""
    return sadiya(liga)[0] is not None


# ═════════════════════════════════════════════════════════ ЧАСЪТ
def epoh(iso):
    """ISO час -> секунди от епохата. None при липса или боклук.

    Pinnacle пише „2026-09-29T21:00:00Z" в matchups и „...+00:00" в markets.
    И двете са UTC; разчитат се без чужди библиотеки.
    """
    t = str(iso or "").strip().replace(" ", "T")
    if not t:
        return None
    if t.endswith("Z"):
        t = t[:-1]
    opashka = t[10:]
    for znak in ("+", "-"):
        if znak in opashka:
            t = t[:10] + opashka.split(znak)[0]
            break
    if "." in t:
        t = t.split(".")[0]
    for fmt in ("%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M", "%Y-%m-%d"):
        try:
            return float(calendar.timegm(time.strptime(t, fmt)))
        except ValueError:
            continue
    return None


def dni_napred(iso, sega=None):
    """Колко ДНИ напред е този старт. None, ако дата няма."""
    ts = epoh(iso)
    if ts is None:
        return None
    return (ts - float(sega if sega is not None else time.time())) / 86400.0


def sezon_status(sega=None):
    """Списък (код, дата, дни_напред, бележка). Чист — нищо не пита.

    Отговаря на „кога", с ЧИСЛО. Причината да съществува е записана в sezon.py:
    здравният преглед твърдеше „хокеят тръгва около 15.09" и сбърка с 14 дни.
    """
    s = float(sega if sega is not None else time.time())
    out = []
    for kod, data, beleshka in DATI:
        d = dni_napred(data + "T00:00:00Z", s)
        out.append((kod, data, None if d is None else round(d, 1), beleshka))
    return out


# ═════════════════════════════════════════════════════════ ВПИСВАНЕТО
def registrirai(pin=None):
    """Вписва хокея в pinnacle.SPORT_ID. True, ако ключът е там.

    🔴 ЕДИНСТВЕНОТО СТРАНИЧНО ДЕЙСТВИЕ НА ТОЗИ ФАЙЛ — и то е нарочно, по
    установения начин (boks.py:167 прави същото).

    `pinnacle.machove/pazari` тръгват от SPORT_ID; няма ли „hockey" там, те
    връщат {} БЕЗ да са питали — тоест мълчаливо, неразличимо от извън сезон.
    Същият ключ отваря и другите две врати, които вече съществуват:
        predictor.dobavi_pazar   ->  `if _b in PIN.SPORT_ID: PIN.ceni_za(...)`
        pazar.pat_do_zatvaryane  ->  `„pinnacle" if kl in PIN.SPORT_ID`
    Тоест с този един ключ хокеят получава и цена при пускане, и ЗАТВАРЯЩА
    цена, тоест CLV — без нито ред промяна в чужд файл.

    Вписва се само със `setdefault`: сложи ли някой ден pinnacle.py свой номер,
    неговият печели.
    """
    pin = pin if pin is not None else _modul("pinnacle")
    if pin is None:
        return False
    karta = getattr(pin, "SPORT_ID", None)
    if not isinstance(karta, dict):
        return False
    karta.setdefault(NASH_KLYUCH, PIN_ID)
    return NASH_KLYUCH in karta


def surovi(pin=None):
    """(мачове, цени) от Pinnacle, или NEPITAN.

    🔴 НУЛА МАЧОВЕ Е ТРИ РАЗЛИЧНИ ОТГОВОРА, НЕ ДВА. `pinnacle._j` гълта всяка
    мрежова грешка и връща None, а `machove` превръща None в {}. При бокса
    двата случая бяха „падна мрежата" и „празен ден". При хокея има ТРЕТИ и
    той е нормалният: ИЗВЪН СЕЗОН. Затова при нула се пита ЕТАЛОНЕН спорт:
        нула хокей + нула еталон  = запушен извор   -> NEPITAN
        нула хокей + жив еталон   = честна нула     -> ({}, {})
    Кой от двата е, се вижда от `sezon_status`, не се гадае.
    """
    pin = pin if pin is not None else _modul("pinnacle")
    if pin is None:
        return NEPITAN
    if not registrirai(pin):
        return NEPITAN
    try:
        mm = pin.machove(NASH_KLYUCH)
        cc = pin.pazari(NASH_KLYUCH)
    except Exception:                                        # noqa: BLE001
        return NEPITAN
    if not isinstance(mm, dict) or not isinstance(cc, dict):
        return NEPITAN
    if not mm:
        try:
            et = pin.machove(ETALON)
        except Exception:                                    # noqa: BLE001
            return NEPITAN
        if not isinstance(et, dict) or not et:
            return NEPITAN
    return (mm, cc)


def pazar_60(pin=None, suro=None):
    """{номер: (дом, гост, РАВЕН)} за РЕДОВНОТО ВРЕМЕ (period 6). Може да е {}.

    🔴 ЗАЩО СЪЩЕСТВУВА, ЩОМ КАРТАТА НЕ ГО ПОЛЗВА. Защото мълчанието за втория
    пазар е точно начинът, по който DVA_IZHODA ни изгори: някой утре ще види
    „draw" в суровия отговор и ще реши, че сме пропуснали равенството. Тук
    пише черно на бяло, че НЕ е пропуснато, а е ИЗМЕРЕНО и отхвърлено — и
    `sverka_izhodi` дава числото, с което е отхвърлено.

    Нула НОВИ заявки: чете същия кеширан отговор като `pinnacle.pazari`.
    """
    if pin is None:
        pin = _modul("pinnacle")
    if suro is None:
        if pin is None or not hasattr(pin, "_surovi"):
            return {}
        if not registrirai(pin):
            return {}
        try:
            suro = pin._surovi(NASH_KLYUCH)
        except Exception:                                    # noqa: BLE001
            return {}
    deset = getattr(pin, "deset", None) if pin is not None else None
    if deset is None:
        return {}
    out = {}
    for k in (suro or []):
        if not isinstance(k, dict):
            continue
        if k.get("type") != "moneyline" or k.get("period") != 6:
            continue
        if k.get("isAlternate"):
            continue
        d = g = r = None
        for pr in (k.get("prices") or []):
            ime = str(pr.get("designation") or "").lower()
            if ime == "home":
                d = deset(pr.get("price"))
            elif ime == "away":
                g = deset(pr.get("price"))
            elif ime == "draw":
                r = deset(pr.get("price"))
        if d is None and g is None and r is None:
            continue
        out[str(k.get("matchupId"))] = (d, g, r)
    return out


def sverka_izhodi(cen0, cen6):
    """[(номер, p0_дом, p6_дом, p6_равен, p6_дом + p6_равен/2)] — чиста функция.

    Числото, с което триизходният пазар беше отхвърлен. Ако последната колона
    се разминава от втората, значи period 6 НЕ е редовното време и цялото
    заглавие на този файл е грешно. Тоест това е проверката, която може да
    обори собственото ми обяснение.
    """
    out = []
    for nomer, tri in sorted((cen6 or {}).items()):
        dve = (cen0 or {}).get(str(nomer))
        if not isinstance(dve, (list, tuple)) or len(dve) < 2:
            continue
        if dve[0] is None or dve[1] is None:
            continue
        if not isinstance(tri, (list, tuple)) or len(tri) < 3:
            continue
        if tri[0] is None or tri[1] is None or tri[2] is None:
            continue
        try:
            s0 = 1.0 / float(dve[0]) + 1.0 / float(dve[1])
            s6 = sum(1.0 / float(x) for x in tri[:3])
            if s0 <= 0 or s6 <= 0:
                continue
            p0 = (1.0 / float(dve[0])) / s0
            p6 = (1.0 / float(tri[0])) / s6
            pr = (1.0 / float(tri[2])) / s6
        except (TypeError, ValueError, ZeroDivisionError):
            continue
        out.append((str(nomer), round(p0, 4), round(p6, 4), round(pr, 4),
                    round(p6 + pr / 2.0, 4)))
    return out


def chisti_p(cena_dom, cena_gost):
    """(p_дом, p_гост) с махнат марж, взето на заем от pazar.bez_marzh.

    Не се преписва: маржът е измерен и обяснен там, а два преписа на едно
    правило са начин единият да се поправи, а другият да остане крив.
    Името тук е РАЗЛИЧНО нарочно — `bez_marzh` съществува в два файла и
    едноименна функция вече е маскирала мъртъв код веднъж (виж cyalost.py).

    Подава се НАШИЯТ ключ „hockey": `pazar.IZHODI` няма такъв ключ, тоест
    пада на подразбиращите се ДВА изхода — точно каквото е period 0.

    (None, None) без pazar.py — числото се пропуска, не се измисля.
    """
    pz = _modul("pazar")
    if pz is None or not hasattr(pz, "bez_marzh"):
        return (None, None)
    try:
        p = pz.bez_marzh(NASH_KLYUCH, cena_dom, cena_gost)
    except Exception:                                        # noqa: BLE001
        return (None, None)
    if not isinstance(p, (list, tuple)) or len(p) < 2:
        return (None, None)
    return (p[0], p[1])


# ═════════════════════════════════════════════════════════ СИТОТО
def prazen_otchet():
    """Отчетът на ситото, преди да е минал един запис."""
    return {"vsichko": 0, "schupeni": 0, "bez_data": 0, "spekulativni": [],
            "nesadimi": {}, "zapochnali": 0, "izvan": 0, "bez_cena": 0,
            "godni": 0}


def sito(mach, cen, sega=None, dni=None):
    """(годни, отчет). ЧИСТА функция — нито една заявка вътре.

    `dni=None` значи БЕЗ прозорец. `dni=1` значи „днес и утре".

    🔴 РЕДЪТ НА ОТПАДАНЕТО Е ЧАСТ ОТ ОТГОВОРА, точно както при бокса.
    Спекулативните и НЕСЪДИМИТЕ се броят ПРЕДИ прозореца на деня. Обратният
    ред би направил и двете мерки НУЛА винаги: приятелски мач вдругиден щеше
    да пада като „извън прозореца", а не като „няма кой да го отсъди" — тоест
    точно числото, заради което ситото съществува, щеше да казва, че ситото
    не прави нищо.

    Несъдимите се връщат ПОИМЕННО по лига, защото „отпаднаха 5" без имената
    им не може да бъде оспорено от никого.
    """
    s = float(sega if sega is not None else time.time())
    otchet = prazen_otchet()
    godni = []
    for nomer, red in sorted((mach or {}).items()):
        otchet["vsichko"] += 1
        if not isinstance(red, (list, tuple)) or len(red) < 2:
            otchet["schupeni"] += 1
            continue
        dom, gost = str(red[0] or ""), str(red[1] or "")
        liga = str(red[2] or "") if len(red) > 2 else ""
        iso = str(red[3] or "") if len(red) > 3 else ""
        if not _norm(dom) or not _norm(gost) or _norm(dom) == _norm(gost):
            otchet["schupeni"] += 1
            continue
        d = dni_napred(iso, s)
        if d is None:
            otchet["bez_data"] += 1
            continue
        if d > SPEKULA_DNI:
            otchet["spekulativni"].append((dom, gost, round(d, 1), iso))
            continue
        # 🔴 БЕЗ СЪДИЯ НЕ Е КАРТА. Виж „КРЪСТОСВАНЕТО" в заглавието.
        if not sadima(liga):
            klyuch = liga or "(без лига)"
            otchet["nesadimi"][klyuch] = otchet["nesadimi"].get(klyuch, 0) + 1
            continue
        if d * 86400.0 < LEAD_SEK:
            otchet["zapochnali"] += 1
            continue
        if dni is not None and d > float(dni):
            otchet["izvan"] += 1
            continue
        c = (cen or {}).get(str(nomer))
        cd = c[0] if isinstance(c, (list, tuple)) and len(c) > 0 else None
        cg = c[1] if isinstance(c, (list, tuple)) and len(c) > 1 else None
        # И двете цени са условие, не удобство: с една страна маржът не може
        # да се махне, а суровото 1/цена надува пазара с измерените 7.5%.
        if cd is None or cg is None:
            otchet["bez_cena"] += 1
            continue
        pd, pg = chisti_p(cd, cg)
        sad, ime = sadiya(liga)
        godni.append({
            "id": str(nomer), "dom": dom, "gost": gost, "liga": liga,
            "sadiya": sad, "liga_bg": ime,
            "start": iso, "start_ts": epoh(iso), "dni": round(d, 3),
            "cena_dom": cd, "cena_gost": cg, "p_dom": pd, "p_gost": pg,
            # Изричното твърдение на картата. Стои В ЗАПИСА, не в главата на
            # някого: „1" печели и при победа в продълженията, а измереното от
            # пазара равенство в редовното време е 21-23%.
            "period": "цял мач, с продълженията",
        })
    godni.sort(key=lambda x: x["start_ts"])
    otchet["godni"] = len(godni)
    return godni, otchet


def fixtures_s_otchet(sega=None, dni=None, pin=None, mach=None, cen=None):
    """(годни, отчет) или NEPITAN. Тук живее ЕДИНСТВЕНОТО питане към Pinnacle."""
    if mach is None and cen is None:
        sur = surovi(pin)
        if sur is NEPITAN:
            return NEPITAN
        mach, cen = sur
    return sito(mach or {}, cen or {}, sega, dni)


def fixtures(sega=None, dni=None, pin=None, mach=None, cen=None):
    """Предстоящите СЪДИМИ хокейни мачове С ЦЕНА. NEPITAN = не можах да питам.

    🔴 ГОЛОТО `fixtures()` ТРЯБВА ДА РАБОТИ. В този проект вече хванахме
    модул, чиито 45 проверки минаваха, а естественото извикване връщаше None
    ВИНАГИ, защото си строеше указателя от празни речници. Затова: не са ли
    подадени данни, ВЗИМАТ СЕ — и точно този път се изпитва в самопроверката.
    """
    r = fixtures_s_otchet(sega, dni, pin, mach, cen)
    return NEPITAN if r is NEPITAN else r[0]


def krastosvane(mach):
    """{"sadimi": {лига: брой}, "bez_sadiya": {лига: брой}} — чиста функция.

    Отговаря на въпроса, който този файл смята за главния: не „колко мача имат
    цена" и не „колко мача имат резултат", а КОЛКО МАЧА ИМАТ И ДВЕТЕ.
    """
    a, b = {}, {}
    for _n, red in sorted((mach or {}).items()):
        if not isinstance(red, (list, tuple)) or len(red) < 3:
            continue
        liga = str(red[2] or "") or "(без лига)"
        kade = a if sadima(liga) else b
        kade[liga] = kade.get(liga, 0) + 1
    return {"sadimi": a, "bez_sadiya": b}


# ═════════════════════════════════════════════════════════ ТЪРСЕНЕ ПО ИМЕНА
def index(mach, cen):
    """Списък записи за търсене по имена. САМО от съдимите лиги.

    Тук НЕ се сее прозорецът: ситото казва кой мач става за КАРТА, а
    указателят отговаря на друг въпрос — „каква е цената на тази двойка
    имена". Мач, който вече е започнал, пак има цена, и опресняването я иска.

    🔴 НО БЕЛИЯТ СПИСЪК СЕ СЕЕ И ТУК. Точно това прави моста по прякор
    безопасен: „Rangers" не може да срещне „Kitchener Rangers", защото
    юношеската лига изобщо не влиза в указателя. Виж заглавието.
    """
    out = []
    for nomer, red in sorted((mach or {}).items()):
        if not isinstance(red, (list, tuple)) or len(red) < 2:
            continue
        dom, gost = str(red[0] or ""), str(red[1] or "")
        if not _norm(dom) or not _norm(gost) or _norm(dom) == _norm(gost):
            continue
        liga = str(red[2] or "") if len(red) > 2 else ""
        if not sadima(liga):
            continue
        c = (cen or {}).get(str(nomer))
        cd = c[0] if isinstance(c, (list, tuple)) and len(c) > 0 else None
        cg = c[1] if isinstance(c, (list, tuple)) and len(c) > 1 else None
        if cd is None and cg is None:
            continue
        out.append({"id": str(nomer), "dom": dom, "gost": gost, "liga": liga,
                    "start": str(red[3] or "") if len(red) > 3 else "",
                    "cena_dom": cd, "cena_gost": cg,
                    "nd": _norm(dom), "ng": _norm(gost)})
    return out


def _index_ili_vzemi(ind, mach, cen, pin=None):
    """Указателят: подаденият, или взет от Pinnacle. NEPITAN при отказ."""
    if ind is not None:
        return ind
    if mach is None and cen is None:
        sur = surovi(pin)
        if sur is NEPITAN:
            return NEPITAN
        mach, cen = sur
    return index(mach or {}, cen or {})


def _otgovor(r, nd):
    """Записът, върнат в НАШИЯ ред на страните. None, ако не се разпознава.

    🔴 ДОМАКИНЪТ ПРИ ТЯХ Е НАШИЯТ ДОМАКИН — ПРОВЕРЕНО, НО НЕ ПРЕЗУМИРАНО.
    Мерено днес: Pinnacle пише „away @ home" в същия ред като НХЛ. Въпреки
    това обръщането се проверява и се обявява с флага „obarnat": той влиза в
    дневника и по-късно затварящата цена се взима със същия флаг, без ново
    сверяване на имена. Сгрешена страна значи цената на противника — тихо и с
    вид на успех.
    """
    if nd and nd == r["nd"]:
        obarnat = False
    elif nd and nd == r["ng"]:
        obarnat = True
    else:
        return None
    cd, cg = r["cena_dom"], r["cena_gost"]
    if obarnat:
        cd, cg = cg, cd
    return {"dom": cd, "gost": cg, "nomer": r["id"], "liga": r["liga"],
            "start": r["start"], "obarnat": obarnat}


def _dvoyka_po_nastavka(ind, dom, gost):
    """[(запис, полето на НАШИЯ домакин)] — мачовете, в които ЕДИНИЯТ край
    свършва на прякора на нашия домакин, а ДРУГИЯТ — на прякора на госта.

    🔴 УНИКАЛНОСТТА СЕ ИСКА ОТ ДВОЙКАТА, НЕ ОТ ДУМАТА (поправено 25.08.2026).
    Дотук всеки прякор трябваше да хване ТОЧНО ЕДИН запис на ЦЕЛИЯ указател.
    За лига, в която един отбор играе много мачове, това условие е неизпълнимо
    по устройство: „Boston Bruins“ стои и в мача с Ню Йорк, и в мача с Торонто,
    значи „Bruins“ хващаше ДВА записа и цената мълчеше. Измерено в самия този
    файл: две проверки падаха точно на това — прякорът на Монреал и прякорът
    на Ню Йорк. Мълчанието изглеждаше като предпазливост, а беше слепота.

    Постъпва се като `pinnacle.nameri`, който реши същия въпрос при фамилиите:
    там се сравнява МНОЖЕСТВОТО от двете страни на ЕДИН запис
    (`{_familiya(a), _familiya(b)} == {fd, fg}`), а не колко пъти се среща
    отделната фамилия. Тук е същото, само че с НАСТАВКА вместо фамилия.

    Пази се обаче онова, което струваше „Bury FC“ вместо „Atlanta United“:
    хванат ли се ДВА РАЗНИ мача, се мълчи. Затова се връща списък, а `cena`
    иска дължина 1 — стеснението е върху двойката, не изчезва.

    Под 4 знака не се търси: твърде къс низ е наставка на всичко.
    """
    kd, kg = _norm(dom), _norm(gost)
    if len(kd) < 4 or len(kg) < 4 or kd == kg:
        return []
    out = []
    for r in ind:
        pryamo = r["nd"].endswith(kd) and r["ng"].endswith(kg)
        obratno = r["ng"].endswith(kd) and r["nd"].endswith(kg)
        if pryamo and obratno:
            continue                     # двойката пасва и в двете посоки
        if pryamo:
            out.append((r, "nd"))
        elif obratno:
            out.append((r, "ng"))
    return out


def cena(dom, gost, ind=None, mach=None, cen=None, pin=None):
    """Цената за НАШИТЕ две имена. None = няма. NEPITAN = не можах да питам.

    Два пътя, от строгото към хлабавото, и ДВАТА мълчат при спор:
      1. пълните имена съвпадат (след махане на акцентите — иначе Монреал пада)
      2. НХЛ дава ПРЯКОР („Hurricanes“), Pinnacle дава ПЪЛНО име („Carolina
         Hurricanes“) — двата прякора се търсят като НАСТАВКИ на ДВЕТЕ страни
         на ЕДИН И СЪЩ запис, на РАЗНИ страни, и такъв запис трябва да е
         ТОЧНО ЕДИН на целия указател.

    Условието „точно един" не е предпазливост, а урок: на 25.08.2026 в този
    проект „Atlanta United FC vs Sporting Kansas City" хвана „Bury FC vs
    Lancaster City" по общи думи. Мълчание вместо цената на друг отбор.

    🔴 НО УНИКАЛНОСТТА Е НА ДВОЙКАТА, НЕ НА ДУМАТА. Виж
    `_dvoyka_po_nastavka`: искаше ли се всяка дума поотделно да е уникална,
    отбор с два мача на витрината оставаше без цена — измерено, две проверки
    в този файл падаха точно на това.
    """
    ind = _index_ili_vzemi(ind, mach, cen, pin)
    if ind is NEPITAN:
        return NEPITAN
    nd, ng = _norm(dom), _norm(gost)
    if not nd or not ng or nd == ng:
        return None

    tochni = [r for r in ind if {r["nd"], r["ng"]} == {nd, ng}]
    if len(tochni) == 1:
        return _otgovor(tochni[0], nd)
    if len(tochni) > 1:
        return None                      # спор, който не се разрешава

    dvoyki = _dvoyka_po_nastavka(ind, dom, gost)
    if len(dvoyki) != 1:
        return None                      # нула или спор — и двете са мълчание
    r, pole = dvoyki[0]
    return _otgovor(r, r[pole])


